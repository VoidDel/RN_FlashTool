{
  "name": "stm32-flash-tool",
  "version": "1.0.0",
  "description": "STM32固件烧录工具 - Electron版本",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux",
    "build-mac": "electron-builder --mac"
  },
  "keywords": [
    "stm32",
    "firmware",
    "flash",
    "openocd",
    "electron"
  ],
  "author": "STM32 Flash Tool",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
    "build": {
    "appId": "com.stm32flashtool.app",
    "productName": "STM32固件烧录工具",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules",
      "!dist",
      "!build"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}