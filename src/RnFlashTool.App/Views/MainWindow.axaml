<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RnFlashTool.App.ViewModels"
        xmlns:models="clr-namespace:RnFlashTool.App.Models"
        x:Class="RnFlashTool.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RN FlashTool"
        Width="1000"
        Height="700"
        MinWidth="880"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">

    <DockPanel>

        <!-- 顶栏 -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="18,11">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="RN FlashTool" />
                    <TextBlock Classes="hint" Text="OpenOCD 驱动 · 芯片列表来自 chips/ 目录的 YAML 配置" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="notice"
                            HorizontalAlignment="Right"
                            MaxWidth="380"
                            Content="{Binding AppUpdateNotice}"
                            Command="{Binding ShowAppUpdateCommand}"
                            IsVisible="{Binding HasAppUpdateNotice}" />

                    <Button Classes="notice"
                            HorizontalAlignment="Right"
                            MaxWidth="380"
                            Content="{Binding UpdateNotice}"
                            Command="{Binding ManageOpenOcdCommand}"
                            IsVisible="{Binding HasUpdateNotice}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis" />

                <!-- 状态栏右侧：OpenOCD 版本与程序版本，点击分别打开版本管理 / 更新 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Classes="statusbar"
                            Content="{Binding OpenOcdStatusText}"
                            Command="{Binding ManageOpenOcdCommand}"
                            ToolTip.Tip="{Binding OpenOcdSummary}" />
                    <TextBlock Classes="hint" Text="·" Margin="4,0" />
                    <Button Classes="statusbar"
                            Content="{Binding AppVersionText}"
                            Command="{Binding ShowAppUpdateCommand}"
                            ToolTip.Tip="点击检查程序更新" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar DockPanel.Dock="Bottom"
                     IsIndeterminate="{Binding IsBusy}"
                     IsVisible="{Binding IsBusy}" />

        <Grid Margin="16,14" ColumnDefinitions="398,14,*">

            <!-- 左栏：配置可滚动，操作区固定在底部 -->
            <DockPanel>

                <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Classes="section" Text="操作" />

                        <UniformGrid Columns="2">
                            <Button Classes="accent action"
                                    Content="烧录固件"
                                    Command="{Binding FlashCommand}" />
                            <Button Classes="action"
                                    Content="验证固件"
                                    Command="{Binding VerifyCommand}" />
                            <Button Classes="action"
                                    Content="读取固件"
                                    Command="{Binding ReadCommand}" />
                            <Button Classes="action"
                                    Content="复位设备"
                                    Command="{Binding ResetCommand}" />
                        </UniformGrid>

                        <Grid ColumnDefinitions="Auto,72,*,Auto" Margin="0,2,0,0">
                            <TextBlock Classes="label" Text="超时(秒)" />
                            <TextBox Grid.Column="1" Text="{Binding TimeoutSeconds}" />
                            <!-- 右边距要和上方按钮的 6px 一致，否则右边缘对不齐 -->
                            <Button Grid.Column="3"
                                    Margin="0,0,6,0"
                                    Content="取消操作"
                                    Command="{Binding CancelCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel Spacing="8">

                        <!-- 固件配置 -->
                        <Border Classes="card">
                            <StackPanel>
                                <TextBlock Classes="section" Text="固件配置" />

                                <Grid ColumnDefinitions="62,*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      Margin="0">
                                    <TextBlock Classes="label" Text="固件文件" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding FirmwarePath}"
                                             PlaceholderText="选择 .elf / .bin 文件"
                                             ToolTip.Tip="{Binding FirmwarePath}" />
                                    <Button Grid.Column="2"
                                            Margin="6,0,0,0"
                                            MinWidth="56"
                                            Content="浏览"
                                            Command="{Binding BrowseFirmwareCommand}" />

                                    <TextBlock Grid.Row="1" Classes="label" Text="格式" Margin="0,8,10,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              Margin="0,8,0,0"
                                              ItemsSource="{Binding Formats}"
                                              SelectedItem="{Binding SelectedFormat}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource FirmwareFormat}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Classes="label" Text="起始地址" Margin="0,8,10,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Margin="0,8,0,0"
                                             Text="{Binding Address}"
                                             ToolTip.Tip="BIN 烧录与“读取固件”都使用该地址；ELF 烧录时由文件自带地址，此处会被忽略" />

                                    <TextBlock Grid.Row="3" Classes="label" Text="读取大小" Margin="0,8,10,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Margin="0,8,0,0"
                                             Text="{Binding ReadSize}"
                                             ToolTip.Tip="“读取固件”时从起始地址读取的字节数，例如 0x10000" />

                                    <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                              Margin="0,8,0,0"
                                              Content="烧录前全片擦除"
                                              IsChecked="{Binding FullErase}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 目标配置 -->
                        <Border Classes="card">
                            <StackPanel>
                                <TextBlock Classes="section" Text="目标配置" />

                                <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Classes="label" Text="编程器" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Interfaces}"
                                              SelectedItem="{Binding SelectedInterface}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ProgrammerInterface">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Classes="label" Text="目标芯片" Margin="0,8,10,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              Margin="0,8,0,0"
                                              MaxDropDownHeight="360"
                                              ItemsSource="{Binding Chips}"
                                              SelectedItem="{Binding SelectedChip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChipDefinition">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           ToolTip.Tip="{Binding Description}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Classes="hint"
                                               Margin="0,6,0,0"
                                               Text="{Binding TargetSummary}"
                                               ToolTip.Tip="{Binding TargetSummary}" />

                                    <StackPanel Grid.Row="3" Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                Margin="-6,6,0,0">
                                        <Button Classes="link"
                                                Content="重新加载"
                                                Command="{Binding ReloadChipsCommand}" />
                                        <Button Classes="link"
                                                Content="打开自定义芯片目录"
                                                Command="{Binding OpenChipFolderCommand}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- 右栏：日志 -->
            <Border Grid.Column="2" Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="操作日志" />

                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="6"
                                Margin="0,10,0,0">
                        <Button Content="保存日志" Command="{Binding SaveLogCommand}" />
                        <Button Content="清除日志" Command="{Binding ClearLogCommand}" />
                    </StackPanel>

                    <TextBox x:Name="LogBox"
                             Classes="log"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Text="{Binding LogText, Mode=OneWay}"
                             TextChanged="OnLogTextChanged" />
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
