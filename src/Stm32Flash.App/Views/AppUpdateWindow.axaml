<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stm32Flash.App.ViewModels"
        x:Class="Stm32Flash.App.Views.AppUpdateWindow"
        x:DataType="vm:AppUpdateViewModel"
        Title="程序更新"
        Width="620"
        Height="520"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">

    <DockPanel Margin="16">

        <!-- 底部：状态、进度与按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="10">
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         IsVisible="{Binding IsBusy}" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="检查更新" Command="{Binding CheckCommand}" />
                    <Button Content="取消" Command="{Binding CancelCommand}" />
                    <Button Classes="accent"
                            Content="下载并安装"
                            Command="{Binding InstallCommand}"
                            IsVisible="{Binding CanSelfUpdate}" />
                    <Button Content="前往下载页"
                            Command="{Binding OpenReleasesPageCommand}"
                            IsVisible="{Binding CannotSelfUpdate}" />
                    <Button Content="关闭" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="10">

            <!-- 版本概览 -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="版本" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Classes="label" Text="当前版本" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" />

                        <TextBlock Grid.Row="1" Classes="label" Text="最新版本" Margin="0,6,10,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Margin="0,6,0,0"
                                   Text="{Binding LatestVersion}"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="2" Classes="label" Text="安装包" Margin="0,6,10,0"
                                   IsVisible="{Binding HasUpdate}" />
                        <StackPanel Grid.Row="2" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,6,0,0"
                                    IsVisible="{Binding HasUpdate}">
                            <TextBlock Classes="hint" Text="{Binding ReleaseSizeText}" />
                            <TextBlock Classes="hint" Text="{Binding ReleaseDateText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 不支持就地升级时的说明 -->
            <Border Classes="notice" IsVisible="{Binding CannotSelfUpdate}">
                <TextBlock Text="{Binding SelfUpdateBlockReason}" TextWrapping="Wrap" />
            </Border>

            <!-- 发行说明 -->
            <Border Classes="card" IsVisible="{Binding HasUpdate}" Height="230">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="更新内容" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding ReleaseNotes}"
                                             TextWrapping="Wrap"
                                             LineHeight="19"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <CheckBox Content="启动时自动检查程序更新" IsChecked="{Binding AutoCheck}" />

        </StackPanel>
    </DockPanel>
</Window>
