<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stm32Flash.App.ViewModels"
        xmlns:models="clr-namespace:Stm32Flash.App.Models"
        x:Class="Stm32Flash.App.Views.OpenOcdManagerWindow"
        x:DataType="vm:OpenOcdManagerViewModel"
        Title="OpenOCD 版本管理"
        Width="820"
        Height="640"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">

    <DockPanel Margin="16">

        <!-- 底部：状态、进度与关闭 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="10">
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         IsVisible="{Binding IsBusy}" />
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Margin="8,0,0,0" Content="取消" Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="关闭" Click="OnCloseClick" />
            </Grid>
        </StackPanel>

        <Grid RowDefinitions="*,Auto,*,Auto" >

            <!-- 已安装 -->
            <Border Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="本机已安装" />

                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,10,0,0">
                        <Button Content="重新扫描" Command="{Binding RefreshCommand}" />
                        <Button Classes="accent" Content="设为当前" Command="{Binding ActivateCommand}" />
                        <Button Content="删除" Command="{Binding UninstallCommand}" />
                        <Button Content="手动指定…" Command="{Binding BrowseCommand}" />
                        <Button Classes="link"
                                Content="打开安装目录"
                                Command="{Binding OpenInstallFolderCommand}" />
                    </StackPanel>

                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              ColumnDefinitions="150,*"
                              Margin="10,0,10,4">
                            <TextBlock Classes="hint" Text="版本" />
                            <TextBlock Grid.Column="1" Classes="hint" Text="路径" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Installations}"
                                 SelectedItem="{Binding SelectedInstallation}"
                                 IsEnabled="{Binding IsIdle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:OpenOcdInstallation">
                                    <Grid ColumnDefinitions="150,*" ToolTip.Tip="{Binding ExecutablePath}">
                                        <TextBlock Text="{Binding Version}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ExecutablePath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Classes="hint"
                       Margin="4,8,0,10"
                       Text="{Binding ActivePath, StringFormat='当前使用: {0}'}"
                       ToolTip.Tip="{Binding ActivePath}" />

            <!-- 在线版本 -->
            <Border Grid.Row="2" Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="在线可下载（xPack OpenOCD 发行版）" />

                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,10,0,0">
                        <Button Content="获取版本列表" Command="{Binding FetchReleasesCommand}" />
                        <Button Classes="accent" Content="下载并安装" Command="{Binding InstallCommand}" />
                    </StackPanel>

                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              ColumnDefinitions="120,100,80,*"
                              Margin="10,0,10,4">
                            <TextBlock Classes="hint" Text="版本" />
                            <TextBlock Grid.Column="1" Classes="hint" Text="发布时间" />
                            <TextBlock Grid.Column="2" Classes="hint" Text="大小" />
                            <TextBlock Grid.Column="3" Classes="hint" Text="安装包" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Releases}"
                                 SelectedItem="{Binding SelectedRelease}"
                                 IsEnabled="{Binding IsIdle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:OpenOcdRelease">
                                    <Grid ColumnDefinitions="120,100,80,*" ToolTip.Tip="{Binding AssetName}">
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PublishedAt, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding AssetName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- 选项 -->
            <Border Grid.Row="3" Classes="card" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Classes="section" Text="下载选项" />
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="label" Text="加速前缀" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding DownloadMirror}"
                                 PlaceholderText="留空表示直连 GitHub"
                                 ToolTip.Tip="访问 GitHub 受限时可填写代理前缀，例如 https://ghfast.top/" />
                        <CheckBox Grid.Column="2"
                                  Margin="12,0,0,0"
                                  Content="启动时检查更新"
                                  IsChecked="{Binding AutoCheckUpdate}" />
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
