{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RN FlashTool",
  "mainBinaryName": "RnFlashTool",
  "identifier": "io.github.voiddel.rnflashtool",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RN FlashTool",
        "width": 1000,
        "height": 700,
        "minWidth": 880,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "xiafeng",
    "copyright": "Copyright (c) 2026 xiafeng",
    "license": "MIT",
    "homepage": "https://github.com/VoidDel/RN_FlashTool",
    "category": "DeveloperTool",
    "shortDescription": "基于 OpenOCD 的跨平台 MCU 烧录工具",
    "longDescription": "RN FlashTool 是基于 OpenOCD 的 MCU 烧录上位机，支持 STM32、ESP32 等芯片的烧录、验证、读取与复位，芯片列表由 YAML 配置。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "chips/*.yaml": "chips/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
