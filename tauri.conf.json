{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RN FlashTool",
  "identifier": "io.github.voiddel.rnflashtool",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RN FlashTool",
        "width": 1000,
        "height": 700,
        "minWidth": 880,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
